# 本地开发数据库（docker compose up -d）
DATABASE_URL=postgres://atoms:atoms@localhost:5433/atoms

# 会话签名密钥，生产环境必须替换为随机长字符串
SESSION_SECRET=replace-with-a-long-random-string

# LLM 配置：兼容任意 OpenAI Chat Completions 协议的端点
# DeepSeek:   https://api.deepseek.com/v1        deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_JUDGE_MODEL=deepseek-chat
LLM_TIMEOUT_MS=120000

# 设为 mock 时强制使用内置示例，不消耗额度；留空则按 LLM_API_KEY 是否存在自动判断
LLM_MODE=
